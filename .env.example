# Rentorra Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# Django Settings
SECRET_KEY=django-insecure-rentorra-change-me-in-production-key-998877
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# In development, leave empty to automatically use local SQLite.
# For PostgreSQL (local or production):
# DATABASE_URL=postgres://rentorra_user:your_secure_password@localhost:5432/rentorra_db
DATABASE_URL=

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@rentorra.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=Rentorra Leads <notifications@rentorra.com>
ADMIN_EMAIL=sales@rentorra.com

# Company Contact Information
WHATSAPP_NUMBER=+919876543210
COMPANY_PHONE=+919876543210
COMPANY_EMAIL=contact@rentorra.com
COMPANY_ADDRESS=Plot 45, Sector 62, Noida, Uttar Pradesh 201309
